# The historical upstream MinIO images are no longer publicly pullable.
# Build the same pinned upstream release from its Go module instead.
FROM golang:1.24.2-alpine AS build
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOMAXPROCS=2
RUN go install -p 2 -ldflags="-s -w" github.com/minio/minio@RELEASE.2025-04-22T22-12-26Z

FROM alpine:3.21
RUN apk add --no-cache ca-certificates && adduser -D -u 10001 minio && mkdir /data && chown minio:minio /data
COPY --from=build /go/bin/minio /usr/local/bin/minio
USER minio
EXPOSE 9000 9001
ENTRYPOINT ["minio"]
CMD ["server", "/data", "--console-address", ":9001"]
