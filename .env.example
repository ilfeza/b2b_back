ENVIRONMENT=development
AUTH_DEV_MODE=true
EXTERNAL_FAKE_MODE=true
SERVICE_KEY=dev-only-internal-key-change-before-deployment
API_PREFIX=/api
PUBLIC_STOREFRONT_PREFIX=/shops
DATABASE_URL=postgresql+asyncpg://b2b:b2b@localhost:5432/marketplace
B2B_SERVICE_URL=http://localhost:8080/api
GOODS_SERVICE_URL=http://localhost:8081/api
PUBLICATIONS_SERVICE_URL=http://localhost:8082/api
USER_SERVICE_URL=http://localhost:8100/api
ORDER_SERVICE_URL=http://localhost:8101/api
PAYMENT_SERVICE_URL=http://localhost:8101/api
ANALYTICS_SERVICE_URL=http://localhost:8102/api
UPSTREAM_TIMEOUT_SECONDS=5
JWT_PUBLIC_KEY=
JWT_ISSUER=
JWT_AUDIENCE=handmade
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=localminio
S3_SECRET_KEY=localminio-secret
S3_BUCKET=handmade-media
S3_PUBLIC_URL=http://localhost:9000/handmade-media
PREMIUM_PRICE=990
FREE_PRODUCT_LIMIT=10
FREE_POST_LIMIT=5
LOW_STOCK_THRESHOLD=3
MAX_UPLOAD_BYTES=5242880

# Kafka: local host address; Compose overrides with kafka:29092.
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_DOCKER_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_B2B_GROUP_ID=handmade.b2b.v1
KAFKA_GOODS_GROUP_ID=handmade.goods.v1
KAFKA_PUBLICATIONS_GROUP_ID=handmade.publications.v1
KAFKA_SELLERS_TOPIC=handmade.sellers.v1
KAFKA_PRODUCTS_TOPIC=handmade.products.v1
KAFKA_PUBLICATIONS_TOPIC=handmade.publications.v1
KAFKA_ORDERS_TOPIC=handmade.orders.v1
KAFKA_ORDERS_ENABLED=false
KAFKA_B2B_DLQ_TOPIC=handmade.dlq.b2b.v1
KAFKA_GOODS_DLQ_TOPIC=handmade.dlq.goods.v1
KAFKA_PUBLICATIONS_DLQ_TOPIC=handmade.dlq.publications.v1
KAFKA_POLL_INTERVAL_SECONDS=0.5
KAFKA_RETRY_BASE_SECONDS=1
KAFKA_RETRY_MAX_SECONDS=30
KAFKA_DELIVERY_TIMEOUT_SECONDS=5
KAFKA_SHUTDOWN_TIMEOUT_SECONDS=10
KAFKA_HANDLER_MAX_ATTEMPTS=3
KAFKA_MAX_EVENT_BYTES=262144
